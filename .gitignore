# dependencies / build output
node_modules/
dist/
*.tsbuildinfo
coverage/

# hub runtime state: TLS private keys and the hazard snapshot must never be committed
hub/.certs/
hub/data/

# model training artefacts (the exported lubak.onnx IS meant to be committed, see app/public/models/README.md)
model/datasets/
model/runs/
model/work/
__pycache__/
*.pyc
*.pt
*.pth

# local env / editor / OS
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# test-only ONNX fixture from model/tools/make_dummy_onnx.py: must never be committed or shipped as the model
app/public/models/dummy*.onnx


# offline map source data (app/scripts/offline_tiles.py fetch); the rendered tiles in app/public/tiles ARE committed
app/.tiles-cache/

# npm run rehearse output (report, screenshots, the rehearsal hub's data)
.rehearsal/
