# dependencies / build output
node_modules/
dist/
*.tsbuildinfo
coverage/

# hub runtime state: TLS private keys and the hazard snapshot must never be committed
hub/.certs/
hub/data/

# model training artefacts (the exported lubak.onnx IS meant to be committed, see app/public/models/README.md)
model/datasets/
model/runs/
model/work/
*.pt
*.pth

# local env / editor / OS
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# generated by app/scripts (copied from node_modules at build time)
app/public/ort/

# generated placeholder map tiles (see app/public/tiles/README.md)
app/public/tiles/*/
